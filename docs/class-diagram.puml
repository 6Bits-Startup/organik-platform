@startuml
' OrganiK Platform 1.0.0 - domain model by bounded context
' Generated from the source code: aggregates, entities, value objects, domain and integration events and ACL facades.

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide empty members

package "iam" {
  class User <<aggregate-root>> {
    -id : Long
    -username : String
    -password : String
    -roles : Set<Role>
    {static} +reconstitute(Long, String, String, Set<Role>) : User
    +addRole(Role) : User
    +addRoles(List<Role>) : User
  }
  class Role <<entity>> {
    -id : Long
    -name : Roles
    +getStringName() : String
    {static} +getDefaultRole() : Role
    {static} +toRoleFromName(String) : Role
    {static} +validateRoleSet(List<Role>) : List<Role>
  }
  enum Roles <<value-object>> {
    ROLE_ADMINISTRATOR
    ROLE_OPERATOR
    ROLE_SUPPLIER
  }
  interface IamContextFacade <<acl-facade>> {
    +createUser(String, String) : Long
    +createUser(String, String, List<String>) : Long
    +fetchUserIdByUsername(String) : Long
    +fetchUsernameByUserId(Long) : String
  }
}

package "profiles" {
  class Profile <<aggregate-root>> {
    -id : Long
    -userId : UserId
    -fullName : FullName
    -email : EmailAddress
    -minimarketId : MinimarketId
    -supplierId : SupplierId
    -preferences : Preferences
    {static} +reconstitute(Long, UserId, FullName, EmailAddress, MinimarketId, SupplierId, Preferences) : Profile
    +updateInformation(FullName) : Profile
    +updatePreferences(Preferences) : Profile
    +adoptExpirationThresholds(Preferences) : Profile
  }
  class EmailAddress <<value-object>> {
    +value : String
  }
  class ExpirationThreshold <<value-object>> {
    +days : Integer
  }
  class FullName <<value-object>> {
    +value : String
  }
  class Language <<value-object>> {
    +value : String
  }
  class MinimarketId <<value-object>> {
    +value : String
  }
  class Preferences <<value-object>> {
    +language : Language
    +warningExpirationDays : ExpirationThreshold
    +criticalExpirationDays : ExpirationThreshold
  }
  class SupplierId <<value-object>> {
    +value : String
  }
  class UserId <<value-object>> {
    +value : Long
  }
  interface ProfilesContextFacade <<acl-facade>> {
    +fetchWarningExpirationDaysByUserId(Long) : Integer
  }
}

package "products" {
  class Category <<aggregate-root>> {
    -id : Long
    -name : CategoryName
    -tone : CategoryTone
    {static} +reconstitute(Long, CategoryName, CategoryTone) : Category
  }
  class Product <<aggregate-root>> {
    -id : Long
    -sku : Sku
    -name : ProductName
    -categoryId : CategoryId
    -supplierId : SupplierId
    -unit : MeasurementUnit
    -minimumStock : MinimumStock
    {static} +reconstitute(Long, Sku, ProductName, CategoryId, SupplierId, MeasurementUnit, MinimumStock) : Product
    +updateInformation(ProductName, CategoryId, SupplierId, MeasurementUnit, MinimumStock) : Product
  }
  class CategoryId <<value-object>> {
    +value : Long
  }
  class CategoryName <<value-object>> {
    +value : String
  }
  enum CategoryTone <<value-object>> {
    GREEN
    BLUE
    ORANGE
    YELLOW
    NEUTRAL
  }
  enum DefaultCategories <<value-object>> {
    FRUITS_VEGETABLES
    DAIRY
    GRAINS
    BEVERAGES
    BAKERY
    FROZEN
  }
  enum MeasurementUnit <<value-object>> {
    UNIT
    KG
    LITER
    PACK
  }
  class MinimumStock <<value-object>> {
    +value : Integer
  }
  class ProductName <<value-object>> {
    +value : String
  }
  class Sku <<value-object>> {
    +value : String
  }
  class SupplierId <<value-object>> {
    +value : String
  }
}

