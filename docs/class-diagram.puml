package "shared" {
  abstract class AbstractDomainAggregateRoot <<aggregate-root>> {
    +domainEvents() : Collection<Object>
    +clearDomainEvents() : void
  }
}

' Relationships inside the bounded contexts
iam.User "*" --> "*" iam.Role : roles
procurements.ShipmentOrder *-- "1..*" procurements.ShipmentOrderLine : lines
products.Product --> products.Category : categoryId
inventory.InventoryMovement --> inventory.StockLot : stockLotId
inventory.Offer --> inventory.StockLot : stockLotId
conservation.StorageReading --> conservation.StorageZone : storageZoneId
suppliers.OfferedProduct --> suppliers.Supplier : supplierId

' Collaboration between bounded contexts
procurements.ShipmentOrderAcceptedIntegrationEvent ..> inventory : registers the stock lots
procurements.ShipmentOrderAcceptedIntegrationEvent ..> communication : ORDER notification
inventory.StockLotLowStockIntegrationEvent ..> communication : LOW_STOCK notification
conservation.StorageReadingOutOfRangeIntegrationEvent ..> communication : CONSERVATION notification
procurements.ShipmentOrderAcceptedIntegrationEvent ..> analytics : activity record
inventory.StockLotLowStockIntegrationEvent ..> analytics : activity record
conservation.StorageReadingOutOfRangeIntegrationEvent ..> analytics : activity record
profiles ..> iam.IamContextFacade : checks the user
dashboard ..> inventory.InventoryContextFacade
dashboard ..> procurements.ProcurementsContextFacade
dashboard ..> requisition.RequisitionContextFacade
dashboard ..> communication.CommunicationContextFacade
dashboard ..> profiles.ProfilesContextFacade
analytics ..> inventory.InventoryContextFacade
analytics ..> procurements.ProcurementsContextFacade
analytics ..> conservation.ConservationContextFacade

@enduml
