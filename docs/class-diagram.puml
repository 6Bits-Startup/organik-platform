    +value : String
  }
  class MinimarketId <<value-object>> {
    +value : String
  }
  class MovementReason <<value-object>> {
    +value : String
  }
  enum MovementType <<value-object>> {
    ENTRY
    EXIT
    ADJUSTMENT
    WASTE
  }
  class OfferPrice <<value-object>> {
    +value : BigDecimal
